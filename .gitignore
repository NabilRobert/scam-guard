# Private notes and handovers never go in the repo.
private/
backups/
HANDOVER*.md
*.local.md

# Secrets
.env
.env.*
!.env.example

# Real messages, screenshots, voice notes and attachments never go in the repo.
# Forwarded messages hold other people's data, and some sources may not be
# redistributed. Scripts read them from here; only labels-free summaries are committed.
data/real/
data/private/
data/raw/
*.apk
*.opus
*.ogg

# Downloaded threat lists: fetched by a script, never committed
data/feeds/

# Generated bulk, dumps and logs
runs/
*.log
*.dump
*.sql.gz

# Python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.coverage

# OS / editor
.DS_Store
.vscode/
.idea/
